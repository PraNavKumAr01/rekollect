  "nc -zv db.internal 5432",
  "sudo ufw allow 443/tcp",
  "ps aux | grep python",
  "kill -9 48213",
  "pkill -f uvicorn",
  "htop",
  "top -o %MEM",
  "nohup python train.py > train.log 2>&1 &",
  "systemctl status nginx",
  "sudo systemctl restart nginx",
  "journalctl -u api --since \"1 hour ago\" -f",
