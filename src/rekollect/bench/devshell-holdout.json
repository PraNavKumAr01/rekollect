  "docker build --no-cache -t api:latest .",
  "docker compose up -d --build",
  "docker compose down -v",
  "docker compose logs -f web",
  "docker exec -it api_web_1 bash",
  "docker system prune -af --volumes",
  "docker image prune -f",
  "docker volume ls",
  "docker stats --no-stream",
  "docker inspect -f '{{.NetworkSettings.IPAddress}}' api_web_1",
  "docker cp api_web_1:/app/logs/error.log ./error.log",
  "docker run --rm -it -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:16",
  "docker login ghcr.io -u acme-bot",
  "docker tag api:latest ghcr.io/acme/api:2.3.0",
  "docker push ghcr.io/acme/api:2.3.0",
  "docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/acme/api:2.3.0 --push .",
