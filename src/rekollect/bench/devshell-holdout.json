  "kubectl logs deploy/api -n prod --since=24h > api-deploy.log",
  "kubectl logs api-7d9f8b-xk2lp -n prod --previous",
  "kubectl rollout restart deploy/api -n prod",
  "kubectl rollout undo deploy/api -n prod",
  "kubectl rollout status deploy/api -n prod",
  "kubectl scale deploy/api --replicas=5 -n prod",
  "kubectl port-forward svc/postgres 5432:5432 -n prod",
  "kubectl exec -it api-7d9f8b-xk2lp -n prod -- sh",
