  "git status",
  "git add -A",
  "git commit -m \"fix login redirect\"",
  "git commit --amend --no-edit",
  "git reset --soft HEAD~1",
  "git reset --hard HEAD~1",
  "git reset HEAD -- src/app.py",
  "git restore --staged .",
  "git checkout -- src/config.yaml",
  "git stash push -m \"wip auth\"",
  "git stash pop",
  "git stash list",
  "git log --oneline --graph --decorate -20",
  "git log -p --follow -- src/billing.py",
  "git blame -L 40,80 src/billing.py",
  "git diff --stat main...HEAD",
  "git diff --cached",
  "git branch -d feature/old-ui",
  "git push origin --delete feature/old-ui",
  "git fetch --prune",
  "git rebase -i HEAD~5",
  "git cherry-pick 4f2a9c1",
  "git revert 3f9c2ab",
  "git clean -fdx",
