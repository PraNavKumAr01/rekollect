  "dig +short api.acme.io",
  "nslookup acme.io 8.8.8.8",
  "ping -c 4 10.0.0.1",
  "traceroute api.acme.io",
  "ssh deploy@10.0.0.12",
  "ssh -L 8888:localhost:8888 gpu-box",
  "ssh -i ~/.ssh/aws.pem ubuntu@ec2-3-90-1-1.compute.amazonaws.com",
  "ssh-keygen -t ed25519 -C \"dev@acme.io\"",
  "ssh-copy-id deploy@10.0.0.12",
  "openssl s_client -connect api.acme.io:443 -servername api.acme.io",
