  "sudo apt update && sudo apt upgrade -y",
  "brew upgrade && brew cleanup",
  "uptime",
  "free -h",
  "nvidia-smi",
  "watch -n 1 nvidia-smi",
  "sudo reboot",
  "ffmpeg -i input.mov -vcodec libx264 -crf 28 output.mp4",
  "ffmpeg -i talk.mp4 -vn -acodec mp3 talk.mp3",
  "ffmpeg -i clip.mp4 -ss 00:00:10 -t 5 -vf \"fps=10,scale=480:-1\" clip.gif",
  "convert screenshot.png -resize 50% small.png",
  "magick mogrify -format webp *.jpg",
