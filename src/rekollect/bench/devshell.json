{
 "name": "devshell",
 "version": 1,
 "description": "A realistic developer shell history and questions with known answers. Most questions are phrased differently from the command (they test meaning); a few are keyword or half-typed searches.",
 "commands": [
  "git status",
  "git add -A",
  "git commit -m \"fix login redirect\"",
  "git commit --amend --no-edit",
  "git reset --soft HEAD~1",
  "git reset --hard HEAD~1",
  "git reset HEAD -- src/app.py",
  "git restore --staged .",
  "git checkout -- src/config.yaml",
  "git stash push -m \"wip auth\"",
  "git stash pop",
  "git stash list",
  "git log --oneline --graph --decorate -20",
  "git log -p --follow -- src/billing.py",
  "git blame -L 40,80 src/billing.py",
  "git diff --stat main...HEAD",
  "git diff --cached",
  "git branch -d feature/old-ui",
  "git push origin --delete feature/old-ui",
  "git fetch --prune",
  "git rebase -i HEAD~5",
  "git cherry-pick 4f2a9c1",
  "git revert 3f9c2ab",
  "git clean -fdx",
  "git tag -a v2.3.0 -m \"release 2.3.0\"",
  "git push --follow-tags",
  "git bisect start HEAD v2.2.0",
  "git reflog",
  "git remote set-url origin git@github.com:acme/api.git",
  "git worktree add ../api-hotfix hotfix/2.3.1",
  "git submodule update --init --recursive",
  "git config --global user.email \"dev@acme.io\"",
  "gh pr create --fill --draft",
  "gh pr checkout 482",
  "gh run watch",
  "docker ps -a",
  "docker build -t api:latest .",
  "docker build --no-cache -t api:latest .",
  "docker compose up -d --build",
  "docker compose down -v",
  "docker compose logs -f web",
  "docker exec -it api_web_1 bash",
  "docker system prune -af --volumes",
  "docker image prune -f",
  "docker volume ls",
  "docker stats --no-stream",
  "docker inspect -f '{{.NetworkSettings.IPAddress}}' api_web_1",
  "docker cp api_web_1:/app/logs/error.log ./error.log",
  "docker run --rm -it -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:16",
  "docker login ghcr.io -u acme-bot",
  "docker tag api:latest ghcr.io/acme/api:2.3.0",
  "docker push ghcr.io/acme/api:2.3.0",
  "docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/acme/api:2.3.0 --push .",
  "kubectl get pods -n prod",
  "kubectl get pods -A -o wide",
  "kubectl describe pod api-7d9f8b-xk2lp -n prod",
  "kubectl logs -f deploy/api -n prod",
  "kubectl logs deploy/api -n prod --since=24h > api-deploy.log",
  "kubectl logs api-7d9f8b-xk2lp -n prod --previous",
  "kubectl rollout restart deploy/api -n prod",
  "kubectl rollout undo deploy/api -n prod",
  "kubectl rollout status deploy/api -n prod",
  "kubectl scale deploy/api --replicas=5 -n prod",
  "kubectl port-forward svc/postgres 5432:5432 -n prod",
  "kubectl exec -it api-7d9f8b-xk2lp -n prod -- sh",
  "kubectl apply -f k8s/",
  "kubectl delete pod api-7d9f8b-xk2lp -n prod",
  "kubectl config use-context prod-eu",
  "kubectl get events -n prod --sort-by=.lastTimestamp",
  "kubectl top pods -n prod",
  "kubectl get secret api-env -n prod -o jsonpath='{.data.DATABASE_URL}' | base64 -d",
